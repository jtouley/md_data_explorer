{
  "name": "clinical-analytics-electron",
  "productName": "Clinical Analytics",
  "version": "0.1.0",
  "description": "Clinical Analytics Desktop App - Electron frontend for FastAPI backend",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:native": "playwright test -c playwright.native.config.js",
    "test:quality": "npm run test:cov && npm run test:e2e && npm run test:e2e:native"
  },
  "keywords": [],
  "author": {
    "name": "jtouley",
    "email": "jtouley@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.57.0",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.2.3",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
